# Google Gemini API Key for LLM Judge Evaluation (e.g., gemini-3.6-flash / gemini-1.5-flash / gemini-2.0-flash)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Confident AI API Key (Optional: for logging and viewing test metrics in Confident AI cloud platform)
# Run `deepeval login` or set CONFIDENT_AI_API_KEY
# CONFIDENT_AI_API_KEY=your_confident_ai_api_key_here
