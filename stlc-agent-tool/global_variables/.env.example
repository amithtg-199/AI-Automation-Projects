# App Settings
HOSTNAME=http://localhost:8000

# LLM Settings
LLM_API_KEY=your_llm_api_key_here
OLLAMA_ENDPOINT=http://localhost:11434

# DB Settings
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/stlc_db

# System Settings
MAX_RETRIES=3
MAX_BATCHES=10
CELERY_WORKERS=4

# API Auth tokens
API_AUTH_TOKEN=your_api_token_here
TOKEN_VALIDITY_SECONDS=3600

# Audit & Tracking
AUDIT_LOG_RETENTION_DAYS=30
COST_LOG_RETENTION_DAYS=90

# Knowledge Hub
KNOWLEDGE_HUB_CRON="0 */12 * * *"

# Encryption Key Path
SECRET_KEY_PATH=./secret.key
